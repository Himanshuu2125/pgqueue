DATABASE_URL=postgres://queue:queue@postgres:5432/queue?sslmode=disable
REDIS_URL=redis://redis:6379/0
API_ADDR=:8080
# worker /metrics, /healthz, /readyz
WORKER_ADDR=:9091
# per process
DB_MAX_CONNS=20
# api only
MIGRATE_ON_START=true
SEED_TENANTS=demo:demo-key-change-me:50:100,bench:bench-key-change-me:100000:100000
WORKER_CONCURRENCY=16
WORKER_QUEUES=default
POLL_INTERVAL_MS=200
LEASE_SECONDS=30
HEARTBEAT_SECONDS=10
REAPER_INTERVAL_SECONDS=5
SHUTDOWN_GRACE_SECONDS=25
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=300000
DEFAULT_MAX_ATTEMPTS=5
DEFAULT_TIMEOUT_SECONDS=60
# comma-separated exact hostnames
HTTP_HANDLER_ALLOWED_HOSTS=api
# secret sent as X-Queue-Token; empty = header not sent
HTTP_HANDLER_QUEUE_TOKEN=
ADMIN_USER=admin
# required
ADMIN_PASSWORD=
LOG_LEVEL=info
# empty = tracing disabled
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
OTEL_TRACES_SAMPLER_RATIO=1.0
